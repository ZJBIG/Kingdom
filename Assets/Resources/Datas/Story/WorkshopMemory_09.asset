  m_Name: WorkshopMemory_09
  m_EditorClassIdentifier: 
  id: WorkshopMemory_09
  Title: "\u7B2C\u4E5D\u7AE0\uFF1A\u5DE5\u574A\u91CC\u7684\u7B2C\u4E8C\u6B21\u53D1\u660E"
  RequiredEra: 3
  Summary: "\u7CBE\u5BC6\u5236\u9020\u8BA9\u7ECF\u9A8C\u53D8\u6210\u6807\u51C6\uFF0C\u5DE5\u574A\u7B2C\u4E00\u6B21\u80FD\u591F\u628A\u4E00\u6B21\u6210\u529F\u4EA4\u7ED9\u964C\u751F\u7684\u540E\u6765\u8005\u3002"
  Body: "\u673A\u5668\u505C\u6446\u540E\u7684\u7B2C\u4E09\u5929\uFF0C\u5E74\u8F7B\u5DE5\u5320\u963F\u680E\u4ECE\u5E9F\u5F03\u9F7F\u8F6E\u7BB1\u91CC\u627E\u51FA\u4E00\u679A\u4ECD\u80FD\u4F7F\u7528\u7684\u94DC\u73AF\u3002\u5979\u6CA1\u6709\u53EA\u628A\u673A\u5668\u4FEE\u597D\uFF0C\u800C\u662F\u7528\u7CBE\u5BC6\u91CF\u5177\u8BB0\u5F55\u5C3A\u5BF8\u3001\u6750\u6599\u548C\u6BCF\u4E00\u6B21\u5931\u8D25\u3002\u5DE5\u574A\u628A\u8FD9\u4E9B\u8BB0\u5F55\u6574\u7406\u6210\u7EDF\u4E00\u56FE\u7EB8\uFF0C\u53E6\u4E00\u5EA7\u805A\u843D\u56E0\u6B64\u80FD\u5728\u534A\u5929\u5185\u5B8C\u6210\u540C\u6837\u7684\u4FEE\u590D\u3002\n\n\u7CBE\u5BC6\u5236\u9020\u6539\u53D8\u7684\u4E0D\u662F\u4E00\u679A\u9F7F\u8F6E\uFF0C\u800C\u662F\u6210\u529F\u88AB\u91CD\u590D\u7684\u65B9\u5F0F\u3002\u5DE5\u5320\u5F00\u59CB\u4E92\u76F8\u6821\u5BF9\u5DE5\u5177\uFF0C\u5B66\u5F92\u4E5F\u88AB\u5141\u8BB8\u8FFD\u95EE\u65E7\u89C4\u77E9\u7684\u6765\u5904\u3002\u5DE5\u4E1A\u77E5\u8BC6\u4ECE\u4E2A\u4EBA\u624B\u827A\u53D8\u6210\u516C\u5171\u6807\u51C6\uFF0C\u4E0B\u4E00\u5EA7\u5DE5\u5382\u7EC8\u4E8E\u53EF\u4EE5\u7AD9\u5728\u4E0A\u4E00\u5EA7\u5DE5\u5382\u7684\u7ECF\u9A8C\u4E0A\u7EE7\u7EED\u524D\u8FDB\uFF0C\u800C\u4E0D\u5FC5\u91CD\u65B0\u652F\u4ED8\u540C\u6837\u7684\u4EE3\u4EF7\u3002"
