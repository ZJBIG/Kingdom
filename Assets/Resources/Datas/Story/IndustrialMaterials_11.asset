  id: IndustrialMaterials_11
  Title: "\u7B2C\u5341\u4E00\u7AE0\uFF1A\u94C1\u8DEF\u5C3D\u5934\u7684\u7089\u706B"
  RequiredEra: 3
  Summary: "\u94C1\u8DEF\u3001\u51B6\u70BC\u548C\u6807\u51C6\u8D27\u8FD0\u628A\u5206\u6563\u7684\u5DE5\u4E1A\u8FDE\u63A5\u6210\u4E00\u6761\u771F\u6B63\u80FD\u591F\u8FDC\u884C\u7684\u751F\u547D\u7EBF\u3002"
  Body: "\u94C1\u8DEF\u5F00\u901A\u540E\u7684\u7B2C\u4E00\u4E2A\u51AC\u5929\uFF0C\u6EE1\u8F7D\u77FF\u77F3\u7684\u5217\u8F66\u5728\u8FDC\u65B9\u505C\u4E86\u4E0B\u6765\u3002\u5DE5\u5382\u91CC\u8FD8\u6709\u71C3\u6599\uFF0C\u7089\u819B\u4E5F\u8DB3\u591F\u575A\u56FA\uFF0C\u5374\u6CA1\u6709\u5408\u9002\u7684\u6750\u6599\u7EE7\u7EED\u751F\u4EA7\u3002\u4FEE\u8DEF\u7684\u9F20\u65CF\u8FDE\u591C\u6E05\u9664\u79EF\u96EA\uFF0C\u51B6\u70BC\u5DE5\u628A\u4E0D\u540C\u77FF\u8109\u7684\u6837\u672C\u6446\u4E0A\u957F\u684C\uFF0C\u8FD0\u8F93\u8005\u5219\u7528\u6807\u51C6\u8D27\u7BB1\u91CD\u65B0\u5B89\u6392\u88C5\u5378\u8282\u594F\u3002\u6BCF\u6279\u6750\u6599\u90FD\u7559\u4E0B\u6765\u6E90\u548C\u53BB\u5411\uFF0C\u65B9\u4FBF\u540E\u6765\u8005\u5728\u7089\u706B\u7184\u706D\u524D\u627E\u5230\u95EE\u9898\u3002\n\n\u4ECE\u6B64\uFF0C\u77FF\u5C71\u3001\u94C1\u8DEF\u548C\u7089\u706B\u4E0D\u518D\u662F\u4E09\u4EF6\u4E8B\u3002\u5B83\u4EEC\u5171\u540C\u7EC4\u6210\u4E00\u6761\u9700\u8981\u88AB\u7167\u6599\u7684\u751F\u547D\u7EBF\uFF1B\u4EFB\u4F55\u4E00\u73AF\u677E\u5F00\uFF0C\u6700\u8FDC\u5904\u7684\u805A\u843D\u5C31\u4F1A\u5148\u611F\u5230\u5BD2\u51B7\u3002\u6807\u51C6\u4E0D\u662F\u675F\u7F1A\uFF0C\u800C\u662F\u8BA9\u964C\u751F\u73ED\u7EC4\u4E5F\u80FD\u63A5\u624B\u4FEE\u590D\uFF0C\u8BA9\u8FDC\u65B9\u7EE7\u7EED\u76F8\u4FE1\u4E0B\u4E00\u5217\u8F66\u4F1A\u62B5\u8FBE\u3002"
