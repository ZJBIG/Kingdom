  m_Name: BeyondTheSky_16
  m_EditorClassIdentifier: 
  id: BeyondTheSky_16
  Title: "\u7B2C\u5341\u516D\u7AE0\uFF1A\u8D34\u8FD1\u592A\u9633\u7684\u706F\u5854"
  RequiredEra: 4
  Summary: "\u7A7F\u8FC7\u592A\u9633\u7CFB\u6DF1\u5904\u7684\u822A\u7EBF\u540E\uFF0C\u738B\u56FD\u5F00\u59CB\u5728\u5F3A\u70C8\u8F90\u5C04\u548C\u592A\u9633\u80FD\u6D41\u4E2D\u5EFA\u7ACB\u771F\u6B63\u7684\u80FD\u6E90\u524D\u54E8\u3002"
  Body: "\u8FDC\u65B9\u884C\u661F\u7684\u8865\u7ED9\u7EBF\u7A33\u5B9A\u540E\uFF0C\u63A2\u6D4B\u961F\u628A\u822A\u7EBF\u8F6C\u5411\u592A\u9633\u7CFB\u6DF1\u5904\u3002\u9760\u8FD1\u592A\u9633\u7684\u73AF\u5883\u4F1A\u707C\u6BC1\u666E\u901A\u8BBE\u5907\uFF0C\u901A\u4FE1\u4E5F\u4F1A\u88AB\u5F3A\u70C8\u8F90\u5C04\u6270\u4E71\uFF1B\u53EA\u6709\u8F68\u9053\u80FD\u6E90\u9635\u5217\u3001\u5929\u6C14\u89C2\u6D4B\u548C\u591A\u91CD\u7EF4\u4FEE\u65B9\u6848\u540C\u65F6\u8FD0\u884C\uFF0C\u524D\u54E8\u624D\u4E0D\u4F1A\u5728\u4E0B\u4E00\u6B21\u98CE\u66B4\u4E2D\u5931\u53BB\u8054\u7CFB\u3002\u503C\u5B88\u8005\u8F6E\u6D41\u5B88\u5728\u8231\u5916\uFF0C\u628A\u6E29\u5EA6\u3001\u8F90\u5C04\u548C\u7535\u529B\u53D8\u5316\u5199\u8FDB\u822A\u884C\u65E5\u5FD7\u3002\n\n\u592A\u9633\u9644\u8FD1\u7684\u8D44\u6E90\u6CA1\u6709\u7ACB\u523B\u53D8\u6210\u8D22\u5BCC\u3002\u5B83\u5148\u6210\u4E3A\u8003\u9A8C\u738B\u56FD\u8C03\u5EA6\u80FD\u529B\u7684\u706F\u5854\uFF1A\u80FD\u6E90\u5FC5\u987B\u4F20\u56DE\u9700\u8981\u5B83\u7684\u5730\u65B9\uFF0C\u98CE\u9669\u5FC5\u987B\u88AB\u63D0\u524D\u9884\u62A5\uFF0C\u6240\u6709\u6210\u679C\u90FD\u8981\u7559\u4E0B\u53EF\u590D\u7528\u7684\u822A\u8DEF\u3002\u6BCF\u4E00\u6B21\u56DE\u4F20\u90FD\u63D0\u9192\u4ED6\u4EEC\uFF0C\u9760\u8FD1\u592A\u9633\u5E76\u4E0D\u7B49\u4E8E\u5F81\u670D\u81EA\u7136\uFF0C\u800C\u662F\u5B66\u4F1A\u5728\u5371\u9669\u8FB9\u7F18\u7EF4\u6301\u5F7C\u6B64\u7684\u751F\u5B58\u3002"
