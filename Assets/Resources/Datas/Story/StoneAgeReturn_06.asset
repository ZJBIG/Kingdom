  m_Name: StoneAgeReturn_06
  m_EditorClassIdentifier: 
  id: StoneAgeReturn_06
  Title: "\u7B2C\u516D\u7AE0\uFF1A\u91CD\u65B0\u5B9A\u5C45"
  RequiredEra: 1
  Summary: "\u9F20\u65CF\u7EC8\u4E8E\u53EF\u4EE5\u628A\u8FC1\u5F99\u8DEF\u7EBF\u753B\u6210\u6751\u843D\uFF0C\u628A\u5B63\u8282\u8BB0\u6210\u5386\u6CD5\u3002"
  Body: "\u8FDB\u5165\u77F3\u5668\u65F6\u4EE3\u5E76\u4E0D\u610F\u5473\u7740\u5FD8\u8BB0\u8352\u91CE\uFF0C\u800C\u662F\u5B66\u4F1A\u8BA9\u8352\u91CE\u6210\u4E3A\u8BA1\u5212\u7684\u4E00\u90E8\u5206\u3002\u704C\u6E89\u3001\u50A8\u7CAE\u3001\u9676\u74F7\u3001\u7EBA\u7EC7\u4E0E\u6587\u5B57\u6CBB\u7406\uFF0C\u628A\u4E00\u6B21\u6B21\u5076\u7136\u7684\u751F\u5B58\u7ECF\u9A8C\u53D8\u6210\u53EF\u4F20\u627F\u7684\u5236\u5EA6\u3002\u6CB3\u5CB8\u88AB\u6316\u51FA\u6C34\u6E20\uFF0C\u8C37\u7269\u88AB\u5206\u7ED9\u5B88\u591C\u548C\u8015\u4F5C\u7684\u4EBA\uFF0C\u9676\u571F\u4E0A\u7684\u523B\u75D5\u5219\u63D0\u9192\u6BCF\u4E2A\u5BB6\u5EAD\u8BB0\u5F97\u5B63\u8282\u3002\n\n\u65B0\u7684\u65F6\u4EE3\u4E0D\u4F1A\u62B9\u53BB\u65E9\u671F\u79EF\u7D2F\uFF0C\u800C\u662F\u628A\u706B\u79CD\u4EA4\u7ED9\u66F4\u5927\u7684\u793E\u4F1A\u3002\u6751\u843D\u7B2C\u4E00\u6B21\u62E5\u6709\u56FA\u5B9A\u8FB9\u754C\uFF0C\u516C\u5171\u5386\u6CD5\u4E5F\u5F00\u59CB\u8BB0\u5F55\u96E8\u6C34\u4E0E\u6536\u6210\u3002\u9F20\u65CF\u4E3A\u5C1A\u672A\u51FA\u751F\u7684\u4EBA\u4FEE\u5EFA\u4ED3\u5E93\uFF0C\u540C\u65F6\u4E89\u8BBA\u54EA\u4E9B\u6545\u4E8B\u503C\u5F97\u523B\u5728\u77F3\u7891\u4E0A\u3002\u5B9A\u5C45\u8BA9\u4ED6\u4EEC\u83B7\u5F97\u571F\u5730\uFF0C\u4E5F\u8BA9\u4ED6\u4EEC\u627F\u62C5\u5B88\u62A4\u571F\u5730\u3001\u90BB\u91CC\u548C\u8BB0\u5FC6\u7684\u8D23\u4EFB\u3002"
