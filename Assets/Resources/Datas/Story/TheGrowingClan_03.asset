  id: TheGrowingClan_03
  Title: "\u7B2C\u4E09\u7AE0\uFF1A\u4F1A\u7559\u4E0B\u7684\u4EBA"
  RequiredEra: 0
  Summary: "\u4EBA\u53E3\u589E\u957F\u610F\u5473\u7740\u706B\u5858\u65C1\u5F00\u59CB\u51FA\u73B0\u4E0D\u5C5E\u4E8E\u540C\u4E00\u4EE3\u4EBA\u7684\u58F0\u97F3\u3002"
  Body: "\u98DF\u7269\u5145\u8DB3\u3001\u706B\u5858\u6E29\u6696\uFF0C\u65CF\u7FA4\u624D\u613F\u610F\u628A\u5E10\u7BF7\u7559\u5728\u540C\u4E00\u7247\u571F\u5730\u4E0A\u3002\u5E74\u8F7B\u7684\u7236\u6BCD\u5728\u5C4B\u6A90\u4E0B\u7167\u6599\u5E7C\u5D3D\uFF0C\u957F\u8005\u628A\u5BFB\u627E\u6C34\u6E90\u548C\u8FA8\u8BA4\u5B63\u8282\u7684\u672C\u9886\u4EA4\u7ED9\u4ED6\u4EEC\uFF1B\u6BCF\u4E2A\u65B0\u5BB6\u5EAD\u90FD\u8BA9\u805A\u843D\u591A\u4E00\u53CC\u624B\uFF0C\u4E5F\u591A\u4E00\u4EFD\u9700\u8981\u88AB\u5B88\u62A4\u7684\u7275\u6302\u3002\u90BB\u5BB6\u7684\u706B\u5149\u5728\u591C\u91CC\u5F7C\u6B64\u56DE\u5E94\uFF0C\u63D0\u9192\u4EBA\u4EEC\u4E0D\u5FC5\u72EC\u81EA\u9762\u5BF9\u5BD2\u51B7\u3002\n\n\u5F53\u7B2C\u4E00\u4E2A\u65B0\u751F\u513F\u88AB\u8BB0\u5165\u65CF\u8C31\uFF0C\u9F20\u65CF\u590D\u5174\u624D\u771F\u6B63\u62E5\u6709\u4E86\u65F6\u95F4\u3002\u5B69\u5B50\u4F1A\u5728\u5C1A\u672A\u8D70\u8FC7\u7684\u9053\u8DEF\u4E0A\u957F\u5927\uFF0C\u628A\u4ECA\u65E5\u7684\u51B3\u5B9A\u5E26\u5230\u66F4\u8FDC\u7684\u5C81\u6708\u3002\u65CF\u7FA4\u4E8E\u662F\u660E\u767D\uFF0C\u4FEE\u5EFA\u5C4B\u820D\u3001\u8015\u79CD\u571F\u5730\u548C\u5B88\u4F4F\u706B\u79CD\uFF0C\u5E76\u4E0D\u662F\u4E3A\u4E86\u70AB\u8000\u7E41\u76DB\uFF0C\u800C\u662F\u4E3A\u4E86\u8BA9\u964C\u751F\u7684\u672A\u6765\u4ECD\u6709\u53EF\u4EE5\u7EE7\u627F\u7684\u5BB6\u56ED\u3002"
  illustration: {fileID: 21300000, guid: 67768720c792fcf4dadff5a60741a7a6, type: 3}
