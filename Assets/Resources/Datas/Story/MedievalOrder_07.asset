  id: MedievalOrder_07
  Title: "\u7B2C\u4E03\u7AE0\uFF1A\u9053\u8DEF\u4E0E\u79E9\u5E8F"
  RequiredEra: 2
  Summary: "\u5F53\u738B\u56FD\u62E5\u6709\u591A\u4E2A\u805A\u843D\uFF0C\u89C4\u5219\u672C\u8EAB\u4E5F\u5FC5\u987B\u6210\u4E3A\u4E00\u79CD\u57FA\u7840\u8BBE\u65BD\u3002"
  Body: "\u8D38\u6613\u3001\u5B66\u9662\u3001\u884C\u653F\u4E0E\u57CE\u5E02\u4F4F\u5B85\u8BA9\u9F20\u65CF\u7B2C\u4E00\u6B21\u80FD\u591F\u5728\u964C\u751F\u65CF\u7FA4\u4E4B\u95F4\u7EF4\u6301\u4FE1\u4EFB\u3002\u9053\u8DEF\u8FDE\u63A5\u7684\u4E0D\u53EA\u662F\u8D27\u7269\uFF0C\u4E5F\u8FDE\u63A5\u4E86\u4E0D\u540C\u805A\u843D\u5BF9\u672A\u6765\u7684\u60F3\u8C61\u3002\u5546\u961F\u5728\u5173\u53E3\u7559\u4E0B\u5370\u8BB0\uFF0C\u5B66\u8005\u66FF\u4E89\u6267\u7684\u53CC\u65B9\u4FDD\u5B58\u8BC1\u8BCD\uFF0C\u57CE\u5899\u4E0A\u7684\u5B88\u536B\u5219\u5B66\u4F1A\u5728\u6536\u7A0E\u4E0E\u6551\u6D4E\u4E4B\u95F4\u5BFB\u627E\u5E73\u8861\u3002\n\n\u738B\u51A0\u7684\u610F\u4E49\u4ECE\u6765\u4E0D\u662F\u6743\u529B\u672C\u8EAB\uFF0C\u800C\u662F\u8BA9\u66F4\u591A\u9F20\u65CF\u76F8\u4FE1\uFF0C\u4ECA\u5929\u6295\u5165\u7684\u52B3\u52A8\u660E\u5929\u4ECD\u6709\u4EF7\u503C\u3002\u57CE\u5E02\u949F\u58F0\u4E3A\u5404\u5730\u6821\u51C6\u65F6\u95F4\uFF0C\u6CD5\u5178\u66FF\u964C\u751F\u4EBA\u5212\u51FA\u5171\u540C\u5E95\u7EBF\u3002\u9F20\u65CF\u4ECD\u4F1A\u4E89\u6267\u3001\u4EA4\u6613\u548C\u5931\u8D25\uFF0C\u4F46\u4ED6\u4EEC\u5F00\u59CB\u76F8\u4FE1\u79E9\u5E8F\u4E0D\u662F\u675F\u7F1A\uFF0C\u800C\u662F\u8BA9\u8FDC\u65B9\u5408\u4F5C\u6210\u4E3A\u53EF\u80FD\u3001\u4E5F\u8BA9\u5F31\u5C0F\u8005\u80FD\u591F\u7533\u8BC9\u7684\u6865\u6881\u3002"
