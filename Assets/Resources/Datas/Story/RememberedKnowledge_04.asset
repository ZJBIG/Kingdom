  id: RememberedKnowledge_04
  Title: "\u7B2C\u56DB\u7AE0\uFF1A\u4ECE\u77F3\u7247\u4E0A\u8BFB\u56DE\u5929\u7A7A"
  RequiredEra: 0
  Summary: "\u7814\u7A76\u8BA9\u9F20\u65CF\u4E0D\u518D\u53EA\u662F\u91CD\u590D\u7956\u5148\u7684\u52A8\u4F5C\uFF0C\u800C\u5F00\u59CB\u7406\u89E3\u5B83\u4EEC\u4E3A\u4F55\u6709\u6548\u3002"
  Body: "\u65E7\u6587\u660E\u7559\u4E0B\u7684\u77E5\u8BC6\u5E76\u4E0D\u5B8C\u6574\u3002\u8BB0\u5F55\u8005\u53EA\u80FD\u4ECE\u6B8B\u7F3A\u7B26\u53F7\u3001\u53CD\u590D\u8BD5\u9A8C\u548C\u751F\u4EA7\u4E2D\u7684\u5931\u8D25\u91CC\uFF0C\u62FC\u56DE\u4E00\u6761\u53EF\u7528\u7684\u9053\u8DEF\u3002\u77F3\u7247\u4E0A\u7684\u523B\u75D5\u5E38\u5E38\u53EA\u6709\u534A\u53E5\uFF0C\u706B\u5806\u65C1\u7684\u4E89\u8BBA\u5374\u80FD\u8865\u4E0A\u53E6\u4E00\u534A\uFF1B\u6BCF\u4F4D\u5B66\u4E60\u8005\u90FD\u8981\u628A\u6240\u5F97\u5199\u4E0B\uFF0C\u518D\u4EA4\u7ED9\u8FD8\u672A\u51FA\u751F\u7684\u540E\u6765\u8005\u3002\n\n\u77E5\u8BC6\u8FDE\u63A5\u7740\u5C4B\u820D\u3001\u751F\u4EA7\u548C\u901A\u5F80\u4E0B\u4E00\u65F6\u4EE3\u7684\u601D\u60F3\uFF0C\u56E0\u6B64\u4ECE\u6765\u4E0D\u662F\u51ED\u7A7A\u964D\u4E0B\u7684\u6069\u8D50\u3002\u7814\u7A76\u8005\u5B66\u4F1A\u5C0A\u91CD\u5931\u8D25\uFF0C\u56E0\u4E3A\u6BCF\u4E00\u6B21\u9519\u8BEF\u90FD\u66FF\u540E\u6765\u8005\u6392\u9664\u4E00\u6761\u5371\u9669\u7684\u8DEF\u3002\u5F53\u65B0\u7684\u7B26\u53F7\u88AB\u5404\u4E2A\u805A\u843D\u7406\u89E3\uFF0C\u8FDC\u65B9\u7684\u4EBA\u4EEC\u7EC8\u4E8E\u80FD\u591F\u4EA4\u6362\u7ECF\u9A8C\uFF0C\u9F20\u65CF\u4E5F\u91CD\u65B0\u62E5\u6709\u4E86\u8DE8\u8D8A\u8DDD\u79BB\u7684\u58F0\u97F3\u3002"
