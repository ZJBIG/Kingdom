  m_Name: TheFirstChain_05
  m_EditorClassIdentifier: 
  id: TheFirstChain_05
  Title: "\u7B2C\u4E94\u7AE0\uFF1A\u8BA9\u4E8B\u7269\u5F7C\u6B64\u76F8\u8FDE"
  RequiredEra: 0
  Summary: "\u539F\u6750\u6599\u7ECF\u8FC7\u52A0\u5DE5\uFF0C\u624D\u4F1A\u53D8\u6210\u80FD\u6539\u53D8\u738B\u56FD\u89C4\u6A21\u7684\u4E1C\u897F\u3002"
  Body: "\u5F53\u91C7\u77F3\u573A\u7684\u539F\u77F3\u88AB\u5207\u77F3\u5DE5\u574A\u52A0\u5DE5\u6210\u7816\uFF0C\u9F20\u65CF\u7B2C\u4E00\u6B21\u770B\u89C1\u5355\u4E2A\u5DE5\u5320\u4E4B\u5916\u7684\u534F\u4F5C\u3002\u539F\u6599\u8981\u6309\u65F6\u62B5\u8FBE\uFF0C\u52A0\u5DE5\u8981\u7559\u4E0B\u8DB3\u591F\u7684\u4F59\u91CF\uFF0C\u6210\u54C1\u8FD8\u8981\u6CBF\u7740\u719F\u6089\u7684\u9053\u8DEF\u9001\u5230\u9700\u8981\u5B83\u7684\u5730\u65B9\uFF1B\u6BCF\u4E00\u6B21\u4EA4\u63A5\u90FD\u8BA9\u805A\u843D\u4E4B\u95F4\u591A\u4E00\u5C42\u4FE1\u4EFB\u3002\n\n\u8FD9\u6761\u89C4\u5F8B\u4F1A\u4E00\u76F4\u4F34\u968F\u9F20\u65CF\uFF1A\u8D8A\u9065\u8FDC\u7684\u76EE\u6807\uFF0C\u8D8A\u9700\u8981\u8BA9\u65E9\u671F\u7684\u4EA7\u4E1A\u7EE7\u7EED\u53D1\u6325\u4F5C\u7528\u3002\u5DE5\u5320\u5F00\u59CB\u7528\u76F8\u540C\u7684\u5C3A\u5EA6\u4EA4\u63A5\u6750\u6599\uFF0C\u8FD0\u8F93\u8005\u6309\u7167\u5B63\u8282\u548C\u706B\u5019\u5B89\u6392\u8DEF\u7EBF\uFF0C\u8BB0\u5F55\u8005\u628A\u5EF6\u8BEF\u4E0E\u4FEE\u8865\u5199\u8FDB\u77F3\u518C\u3002\u6BCF\u4E00\u73AF\u90FD\u53EF\u80FD\u677E\u52A8\uFF0C\u4E5F\u90FD\u503C\u5F97\u88AB\u7406\u89E3\u548C\u7167\u6599\uFF0C\u738B\u56FD\u624D\u4E0D\u4F1A\u5728\u4E0B\u4E00\u573A\u98CE\u96EA\u91CC\u91CD\u65B0\u5206\u6563\u3002"
  illustration: {fileID: 21300000, guid: 991e94cd86b84f5439d9ef11b6a36643, type: 3}
