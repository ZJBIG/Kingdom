  id: IndustrialPower_10
  Title: "\u7B2C\u5341\u7AE0\uFF1A\u8BA9\u5BD2\u591C\u4E5F\u6709\u5149"
  RequiredEra: 3
  Summary: "\u84B8\u6C7D\u52A8\u529B\u548C\u96C6\u4E2D\u80FD\u6E90\u8BA9\u5DE5\u4E1A\u4ECE\u5C40\u90E8\u7684\u5DE5\u5382\uFF0C\u53D8\u6210\u6574\u4E2A\u738B\u56FD\u5171\u540C\u7EF4\u62A4\u7684\u7F51\u7EDC\u3002"
  Body: "\u51AC\u5B63\u63D0\u524D\u5230\u6765\u65F6\uFF0C\u71C3\u6599\u8F66\u961F\u88AB\u79EF\u96EA\u56F0\u5728\u5C71\u53E3\u3002\u84B8\u6C7D\u5382\u82E5\u7EE7\u7EED\u8FD0\u8F6C\uFF0C\u4F4F\u5B85\u533A\u5C31\u4F1A\u5931\u53BB\u53D6\u6696\uFF1B\u82E5\u628A\u71C3\u6599\u7559\u7ED9\u5C45\u6C11\uFF0C\u521A\u5EFA\u6210\u7684\u8BBE\u5907\u53C8\u4F1A\u5728\u971C\u51BB\u4E2D\u635F\u574F\u3002\u738B\u56FD\u7B2C\u4E00\u6B21\u5FC5\u987B\u7528\u7535\u529B\u8C03\u5EA6\u548C\u5171\u540C\u8D26\u76EE\u51B3\u5B9A\u4EC0\u4E48\u5E94\u5F53\u5148\u5F97\u5230\u80FD\u6E90\uFF0C\u8001\u4EBA\u548C\u7089\u5DE5\u5728\u540C\u4E00\u5F20\u957F\u684C\u524D\u4E89\u8BBA\u5230\u6DF1\u591C\u3002\n\n\u84B8\u6C7D\u673A\u91CD\u65B0\u8F6C\u52A8\u540E\uFF0C\u9F20\u65CF\u6CA1\u6709\u5E86\u795D\u4EA7\u91CF\u589E\u52A0\uFF0C\u800C\u662F\u5728\u6BCF\u5EA7\u7089\u65C1\u7559\u4E0B\u71C3\u6599\u8D26\u548C\u5E94\u6025\u4EFD\u989D\u3002\u96C6\u4E2D\u80FD\u6E90\u5E26\u6765\u4E86\u5149\uFF0C\u4E5F\u8BA9\u6BCF\u4E00\u6B21\u505C\u673A\u90FD\u6210\u4E3A\u6240\u6709\u805A\u843D\u5171\u540C\u627F\u62C5\u7684\u8D23\u4EFB\u3002\u53D6\u6696\u3001\u751F\u4EA7\u548C\u4FEE\u7F2E\u4ECE\u6B64\u5171\u4EAB\u540C\u4E00\u6761\u627F\u8BFA\uFF0C\u4EFB\u4F55\u8282\u7701\u90FD\u53EF\u80FD\u6551\u56DE\u8FDC\u65B9\u7684\u4E00\u6237\u4EBA\u5BB6\u3002"
