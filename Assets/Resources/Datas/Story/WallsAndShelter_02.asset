  id: WallsAndShelter_02
  Title: "\u7B2C\u4E8C\u7AE0\uFF1A\u5899\u5185\u7684\u540D\u5B57"
  RequiredEra: 0
  Summary: "\u7B2C\u4E00\u5EA7\u5EFA\u7B51\u8BA9\u4E34\u65F6\u8425\u5730\u53D8\u6210\u4E86\u53EF\u4EE5\u7559\u4E0B\u7684\u5730\u65B9\u3002"
  Body: "\u5EFA\u7B51\u4E0D\u662F\u9759\u6B62\u7684\u88C5\u9970\u3002\u6728\u6881\u3001\u6CE5\u571F\u548C\u77F3\u5757\u88AB\u62FC\u5728\u4E00\u8D77\uFF0C\u4FBF\u66FF\u65CF\u7FA4\u6321\u4F4F\u98CE\u96E8\uFF0C\u4E5F\u66FF\u706B\u79CD\u7559\u4F4F\u591C\u665A\u3002\u6BCF\u4E00\u6B21\u642D\u5EFA\u90FD\u9700\u8981\u6709\u4EBA\u642C\u8FD0\u3001\u6709\u4EBA\u6D4B\u91CF\u3001\u6709\u4EBA\u8BB0\u4F4F\u54EA\u79CD\u8FDE\u63A5\u7ECF\u5F97\u4F4F\u5B63\u8282\u53D8\u5316\uFF1B\u5B8C\u6210\u7684\u5C4B\u820D\u4E8E\u662F\u6210\u4E3A\u53EF\u4EE5\u4F20\u7ED9\u540E\u6765\u8005\u7684\u7ECF\u9A8C\u3002\n\n\u738B\u56FD\u7684\u8F6E\u5ED3\u59CB\u7EC8\u4ECE\u4E00\u9762\u53EF\u9760\u7684\u5899\u5F00\u59CB\u3002\u5899\u5185\u4FDD\u5B58\u7684\u4E0D\u53EA\u662F\u7CAE\u98DF\uFF0C\u8FD8\u6709\u65CF\u8C31\u3001\u706B\u79CD\u548C\u5BF9\u5B63\u8282\u7684\u8BB0\u5FC6\u3002\u5B69\u5B50\u4EEC\u5728\u5899\u4E0B\u5B66\u4E60\u8FA8\u8BA4\u6750\u6599\uFF0C\u8001\u4EBA\u4EEC\u4E3A\u6BCF\u5757\u77F3\u5934\u8BB2\u8FF0\u6765\u5904\uFF0C\u5B88\u591C\u8005\u5219\u5728\u95E8\u8FB9\u8F6E\u6362\u3002\u5C4B\u820D\u8BA9\u4E34\u65F6\u8425\u5730\u6709\u4E86\u5F52\u5904\uFF0C\u4E5F\u8BA9\u5171\u540C\u751F\u6D3B\u6210\u4E3A\u6BCF\u4E2A\u4EBA\u90FD\u613F\u610F\u627F\u62C5\u7684\u627F\u8BFA\u3002"
  illustration: {fileID: 21300000, guid: ee903de2e096fe046bd775b88ae14ce8, type: 3}
