+            ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            ExpantaNum.Zero, ExpantaNum.Zero, ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            ExpantaNum.Zero,
+            new List<Pair<ResourceDef, ExpantaNum>>(),
+            new List<Pair<ResourceDef, ExpantaNum>>
+            {
+                new Pair<ResourceDef, ExpantaNum>(resource, productionRate)
+            },
+            new List<Pair<ResourceDef, ExpantaNum>>());
+        createdObjects.Add(building);
+        return building;
+    }
