+            1d, new ExpantaNum(0.5d), PopulationState.BaseGrowthRatePerSecond, ExpantaNum.Zero, foodShortage);
+        Assert.That(population.PopulationChangeProgress.ToDouble(), Is.GreaterThan(progressBeforeZero),
